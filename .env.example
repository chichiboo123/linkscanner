# ─────────────────────────────────────────────
# Link Scanner 환경변수 (.env)
# 실제 값은 Netlify 대시보드 > Site settings > Environment variables 에 등록하세요.
# 이 파일은 예시이며 절대 실제 키를 커밋하지 마세요.
# ─────────────────────────────────────────────

# Google Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델 우선순위 (쉼표로 구분, 앞에서부터 시도 → 실패 시 다음으로 폴백)
# 비워두면 기본 체인 사용: gemini-3.1-flash-lite → gemini-2.5-flash → gemini-2.0-flash → gemini-1.5-flash
# 예) 1순위를 바꾸거나 후보를 줄이고 싶을 때:
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.0-flash

# GitHub Personal Access Token (선택, public repo 분석 시 rate limit 완화)
# https://github.com/settings/tokens  (권한: public_repo 또는 repo:read 정도면 충분)
GITHUB_TOKEN=your_github_token_here

# Microlink API 키 (선택)
# 스크린샷은 Microlink 렌더링 API로 캡처한다. 키 없이도 동작(무료, 일 50건 한도)하며,
# 한도를 늘리려면 https://microlink.io 에서 발급한 키를 등록한다.
MICROLINK_API_KEY=

# 공유 기능(Netlify Blobs) 폴백 (선택)
# 보통은 Netlify 배포 시 자동으로 동작한다. 만약 "저장소 초기화 실패" 오류가 나면,
# 아래 두 값을 등록하면 명시적으로 동작한다.
#  - NETLIFY_BLOBS_SITE_ID: 사이트 ID (Site settings > General > Site ID)
#  - NETLIFY_BLOBS_TOKEN:   Personal access token (User settings > Applications)
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
